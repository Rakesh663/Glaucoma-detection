# ============================================================================
# Environment Variables for Glaucoma Detection System
# Copy this file to .env and update with your actual values
# ============================================================================

# ====================
# PostgreSQL Configuration
# ====================
POSTGRES_USER=glaucoma_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=glaucoma_db
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICA_PORT=5433

# PostgreSQL Replication
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change_this_replication_password

# ====================
# PgBouncer Configuration
# ====================
PGBOUNCER_PORT=6432

# ====================
# Redis Configuration
# ====================
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379

# ====================
# API Configuration
# ====================
API_PORT=8000
LOG_LEVEL=info

# ====================
# JWT Authentication
# ====================
JWT_SECRET_KEY=change_this_super_secret_jwt_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# OAuth 2.0 (Optional)
# ====================
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTH_PROVIDER=google  # google, github, azure, etc.

# ====================
# Monitoring
# ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ====================
# Application Settings
# ====================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable/disable features
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_AUDIT_LOGS=true

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Rate Limiting (per user/tenant)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY_SECONDS=60

# ====================
# Model Configuration
# ====================
MODEL_PATH=/app/models/best_model.pth
MODEL_CONFIG_PATH=/app/models/config.yaml
MODEL_CACHE_SIZE=100  # Number of cached predictions

# ====================
# Multi-tenancy
# ====================
DEFAULT_TENANT_ID=default
ENABLE_TENANT_ISOLATION=true

# ====================
# Security
# ====================
# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Request limits
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_SIZE=20

# ====================
# Database Connection Pool
# ====================
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ====================
# Redis Cache
# ====================
REDIS_CACHE_TTL=3600  # seconds
REDIS_MAX_CONNECTIONS=50

# ====================
# Logging
# ====================
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout, file, or both
LOG_FILE_PATH=/app/logs/app.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30
